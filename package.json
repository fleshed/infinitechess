{
  "name": "infinitechess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --workspace @infinitechess/server run dev",
    "dev:client": "npm --workspace @infinitechess/client run dev",
    "build": "npm --workspace @infinitechess/client run build && npm --workspace @infinitechess/server run build",
    "start": "npm --workspace @infinitechess/server run start"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  }
}
